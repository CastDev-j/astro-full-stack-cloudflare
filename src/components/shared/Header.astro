---
import { FaBars } from "react-icons/fa";
import { Button } from "../ui/Button";
import { cn } from "@/lib/cn";
import Navigation from "./Navigation";

const { email, name, image } = Astro.locals.user!;

const getInitials = (name: string) => {
  return name
    .split(" ")
    .map((n) => n[0])
    .join("")
    .toUpperCase()
    .slice(0, 2);
};

const routes = [
  { name: "Usuarios", href: "/" },
  { name: "Tareas", href: "/todos" },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-neutral-200 bg-white px-4 py-3 sm:px-6">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
      {
        image ? (
          <img
            src={image}
            alt={name}
            class="size-8 shrink-0 rounded-full object-cover ring-2 ring-neutral-100"
            referrerpolicy="no-referrer"
          />
        ) : (
          <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-neutral-200 text-sm font-semibold text-neutral-700">
            {getInitials(name)}
          </div>
        )
      }
      <div class="min-w-0 text-sm block">
        <p class="truncate font-medium text-neutral-900">{name}</p>
        <p class="truncate text-neutral-500">{email}</p>
      </div>
    </div>

    <Navigation client:load currentPath={currentPath} />
  </div>
</header>

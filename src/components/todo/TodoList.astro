---
import { db } from "@/db";
import { todo } from "@/db/schema";
import { eq } from "drizzle-orm";
import { FaCheck } from "react-icons/fa";

const { id } = Astro.locals.user!;

const todos = await db.select().from(todo).where(eq(todo.userId, id));

function formatDate(date: Date | string) {
  return new Date(date).toLocaleString("es-MX", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
}
---

<ul class="mt-4 flex flex-col gap-2">
  {
    todos.map(({ title, completed, updatedAt, createdAt }) => (
      <li class="rounded-lg border border-neutral-200 bg-white px-4 py-3">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex min-w-0 flex-1 items-center gap-3">
            <div
              class={`text-xs size-5 shrink-0 rounded-full border-2 flex items-center justify-center ${
                completed
                  ? "border-neutral-800 bg-neutral-800 text-white"
                  : "border-neutral-300"
              }`}
            >
              {completed && <FaCheck />}
            </div>

            <span
              class={`truncate text-sm font-medium ${
                completed ? "text-neutral-400 line-through" : "text-neutral-900"
              }`}
            >
              {title}
            </span>
          </div>

          <span
            class={`shrink-0 rounded-full px-3 py-0.5 text-xs font-medium ${
              completed
                ? "bg-neutral-800 text-white"
                : "bg-neutral-100 text-neutral-500"
            }`}
          >
            {completed ? "completado" : "pendiente"}
          </span>
        </div>

        <div class="mt-3 grid grid-cols-2 gap-x-4 border-t border-neutral-100 pt-3">
          <div>
            <p class="text-xs uppercase tracking-wide text-neutral-400">
              createdAt
            </p>
            <p class="mt-0.5  text-xs text-neutral-500">
              {formatDate(createdAt)}
            </p>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wide text-neutral-400">
              updatedAt
            </p>
            <p class="mt-0.5  text-xs text-neutral-500">
              {formatDate(updatedAt)}
            </p>
          </div>
        </div>
      </li>
    ))
  }
</ul>

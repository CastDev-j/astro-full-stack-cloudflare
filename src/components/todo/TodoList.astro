---
import { actions } from "astro:actions";
import TodoListComponent from "./TodoListComponent";

interface Props {
  page: number;
}

const { page } = Astro.props;

const { data } = await Astro.callAction(actions.todo.getTodos, {
  offset: 5,
  page: page,
});

const { success, data: todos, totalCount } = data!;
---

{success && (
  <TodoListComponent
    client:load
    initialTodos={todos ?? []}
    totalCount={totalCount ?? 0}
    page={page}
  />
)}


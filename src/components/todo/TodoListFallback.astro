---
import { Skeleton } from "@/components/ui/Skeleton";
---

<ul class="mt-4 flex flex-col gap-2">
  <li class="flex gap-2">
    <Skeleton className="h-8 flex-1 rounded-lg" />
    <Skeleton className="h-8 w-20 rounded-lg" />
  </li>

  {
    Array.from({ length: 5 }).map((_, i) => (
      <li class="rounded-lg border border-neutral-200 bg-white px-4 py-3">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex min-w-0 flex-1 items-center gap-3">
            <Skeleton className="size-5 shrink-0 rounded-full" />
            <Skeleton className="h-5 w-40 sm:w-52" />
          </div>
          <Skeleton className="h-5 w-20 rounded-full" />
        </div>

        <div class="mt-3 grid grid-cols-2 gap-x-4 border-t border-neutral-100 pt-3">
          <div class="space-y-1">
            <Skeleton className="h-4 w-14" />
            <Skeleton className="h-4 w-28" />
          </div>
          <div class="space-y-1">
            <Skeleton className="h-4 w-14" />
            <Skeleton className="h-4 w-28" />
          </div>
        </div>
      </li>
    ))
  }

  <li class="bg-white px-4 py-3 flex items-center justify-center gap-4">
    <Skeleton className="h-8 w-24 rounded-lg" />
    <Skeleton className="h-4 w-32 rounded" />
    <Skeleton className="h-8 w-24 rounded-lg" />
  </li>
</ul>
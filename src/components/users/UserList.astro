---
import { db } from "@/db";
import { user } from "@/db/schema";
import { Skeleton } from "../ui/Skeleton";

const users = await db.select().from(user);

const getInitials = (name: string) => {
  return name
    .split(" ")
    .map((n) => n[0])
    .join("")
    .toUpperCase()
    .slice(0, 2);
};
---

<div class="flex flex-col gap-6">
  <div class="rounded-lg border border-neutral-200 bg-white">
    <div class="border-b border-neutral-200 px-6 py-4">
      <h3 class="text-lg font-semibold text-neutral-900">
        Usuarios Registrados ({users.length})
      </h3>
    </div>
    <div class="divide-y divide-neutral-200">
      {
        users.map((user) => (
          <div class="flex items-center gap-4 px-6 py-4">
            {user.image ? (
              <img
                src={user.image}
                alt={user.name}
                class="size-10 rounded-full object-cover"
                referrerpolicy="no-referrer"
              />
            ) : (
              <div class="flex size-10 items-center justify-center rounded-full bg-neutral-100 text-sm font-medium text-neutral-600">
                {getInitials(user.name)}
              </div>
            )}

            <div class="flex-1">
              <p class="font-medium text-neutral-900">{user.name}</p>
              <p class="text-sm text-neutral-500">{user.email}</p>
            </div>

            <div class="text-xs">
              {user.emailVerified ? (
                <span class="rounded-full bg-green-100 px-2 py-1 text-green-700">
                  Verificado
                </span>
              ) : (
                <span class="rounded-full bg-neutral-100 px-2 py-1 text-neutral-600">
                  Pendiente
                </span>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

---
import { db } from "@/db";
import { user } from "@/db/schema";
import { Skeleton } from "../ui/Skeleton";

const users = await db.select().from(user);

const getInitials = (name: string) => {
  return name
    .split(" ")
    .map((n) => n[0])
    .join("")
    .toUpperCase()
    .slice(0, 2);
};
---

<div class="flex flex-col gap-6">
  <div class="rounded-lg border border-neutral-200 bg-white">
    <div class="border-b border-neutral-200 px-4 py-4 sm:px-6">
      <h3 class="text-base font-semibold text-neutral-900 sm:text-lg">
        Usuarios Registrados ({users.length})
      </h3>
    </div>
    <div class="divide-y divide-neutral-200">
      {
        users.map((user) => (
          <div class="flex flex-wrap items-center gap-3 px-4 py-4 sm:flex-nowrap sm:gap-4 sm:px-6">
            {user.image ? (
              <img
                src={user.image}
                alt={user.name}
                class="size-9 shrink-0 rounded-full object-cover sm:size-10"
                referrerpolicy="no-referrer"
              />
            ) : (
              <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-neutral-100 text-xs font-medium text-neutral-600 sm:size-10 sm:text-sm">
                {getInitials(user.name)}
              </div>
            )}

            <div class="min-w-0 flex-1">
              <p class="truncate font-medium text-neutral-900">{user.name}</p>
              <p class="truncate text-sm text-neutral-500">{user.email}</p>
            </div>

            <div class="flex w-full justify-end text-xs sm:w-auto">
              {user.emailVerified ? (
                <span class="inline-flex rounded-full bg-green-100 px-2 py-1 text-green-700">
                  Verificado
                </span>
              ) : (
                <span class="inline-flex rounded-full bg-neutral-100 px-2 py-1 text-neutral-600">
                  Pendiente
                </span>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

---
import { Skeleton } from "@/components/ui/Skeleton";
---

<div class="flex flex-col gap-6">
  <div class="rounded-lg border border-neutral-200 bg-white">
    <div class="border-b border-neutral-200 px-4 py-4 sm:px-6">
      <Skeleton className="h-6 w-44 sm:h-7 sm:w-48" />
    </div>
    <div class="divide-y divide-neutral-200">
      {
        Array.from({ length: 3 }).map((_, i) => (
          <div class="flex flex-wrap items-center gap-3 px-4 py-4 sm:flex-nowrap sm:gap-4 sm:px-6">
            <Skeleton className="size-9 rounded-full sm:size-10" />

            <div class="min-w-0 flex-1 space-y-2">
              <Skeleton className="h-5 w-28 sm:w-32" />
              <Skeleton className="h-4 w-full max-w-48" />
            </div>

            <div class="flex w-full justify-end sm:w-auto">
              <Skeleton className="h-6 w-20 rounded-full sm:w-18" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

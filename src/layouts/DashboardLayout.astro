---
import "@/styles/global.css";
import MainLayout from "./MainLayout.astro";
import Header from "@/components/shared/Header.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<MainLayout title={title}>
  <Header />
  <div class="p-6">
    <div class="flex flex-col max-w-6xl mx-auto">
      <slot />
    </div>
  </div>
</MainLayout>

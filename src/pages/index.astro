---
import { db } from "@/db";
import { user } from "@/db/schema";
import MainLayout from "@/layouts/MainLayout.astro";

const users = await db.select().from(user);
---

<MainLayout>
  <h1>Astro + Cloudflare Workers D1</h1>

  {
    users.map((user) => (
      <div class="flex gap-2">
        <>
          <p>{user.name}</p>
          <p>({user.email})</p>
        </>
      </div>
    ))
  }
</MainLayout>

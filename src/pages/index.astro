---
import MainLayout from "@/layouts/MainLayout.astro";
import { env } from "cloudflare:workers";

const { results } = await env.DB.prepare("SELECT * FROM users").run();

console.log(results);
---

<MainLayout>
  <h1>Astro + Cloudflare Workers D1</h1>

  {
    results.map((user) => (
      <div class="flex gap-2">
        <>
          <p>{user.name}</p>
          <p>({user.email})</p>
        </>
      </div>
    ))
  }
</MainLayout>

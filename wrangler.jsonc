{
  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "name": "astro-full-stack-cloudflare",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astro-db",
      "database_id": "c56e5978-33c3-4747-9930-7dba9eef11a4",
      "remote": true,
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
}
